@model List<ExchangeRate>
@{
    ViewData["Title"] = "Məzənnə Tənzimləmələri";
}

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-body p-4">
            <h3 class="mb-4 text-primary"><i class="bi bi-currency-exchange"></i> Valyuta Məzənnələri</h3>
            
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Valyuta</th>
                        <th>1 Vahid (AZN ilə dəyəri)</th>
                        <th>Yenilə</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rate in Model)
                    {
                        <tr>
                            <td><strong>@rate.CurrencyCode</strong></td>
                            <td>
                                <form asp-action="UpdateRate" method="post" class="d-flex">
                                    <input type="hidden" name="code" value="@rate.CurrencyCode" />
                                    <input type="number"
                                           step="0.0001"
                                           name="rate"
                                           class="form-control form-control-sm w-50"
                                           value="@rate.RateToAZN.ToString("G29", System.Globalization.CultureInfo.InvariantCulture)"
                                           lang="en-US" />
                                    <button type="submit" class="btn btn-sm btn-primary ms-2">Yadda Saxla</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @* --- Sənin istədiyin Geri Qayıt butonu burada --- *@
            <div class="mt-4 border-top pt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Admin Panelə Qayıt
                </a>
            </div>

        </div>
    </div>
</div>