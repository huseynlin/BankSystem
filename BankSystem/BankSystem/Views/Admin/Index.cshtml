@model List<BankSystem.Models.User>
@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="container mt-4">
    <div class="card border-0 shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-danger mb-0"><i class="bi bi-shield-lock"></i> Bank İdarəetmə Paneli</h2>

            <a asp-action="CreateUser" class="btn btn-success">
                <i class="bi bi-person-plus"></i> Yeni İstifadəçi Yarat
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Ad Soyad</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Status</th>
                    <th>Hesab Aç</th>
                    <th class="text-center">Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr class="@(user.IsBlocked ? "table-secondary" : "")">
                        <td>@user.Id</td>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td><span class="badge bg-primary">@user.Role</span></td>
                        <td>
                            @if (user.IsBlocked)
                            {
                                <span class="badge bg-danger">Bloklanıb</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Aktiv</span>
                            }
                        </td>
                        <td>
                            <form asp-controller="Admin" asp-action="CreateAccount" method="post" class="row g-2">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <div class="col-auto">
                                    <select name="currency" class="form-select form-select-sm">
                                        <option value="AZN">AZN</option>
                                        <option value="USD">USD</option>
                                        <option value="EUR">EUR</option>
                                        <option value="RUB">RUB</option>
                                    </select>
                                </div>
                                <div class="col-auto">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Aç</button>
                                </div>
                            </form>
                        </td>
                        <td class="text-center">
                            <div class="btn-group">
                                @* --- YENİ: TARİXÇƏ BUTONU --- *@
                                <a asp-action="UserHistory" asp-route-id="@user.Id" class="btn btn-sm btn-primary" title="Tarixçə">
                                    <i class="bi bi-clock-history"></i>
                                </a>

                                <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-warning" title="Redaktə et">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <form asp-action="ToggleBlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(user.IsBlocked ? "btn-secondary" : "btn-info")" title="@(user.IsBlocked ? "Bloku aç" : "Blokla")">
                                        <i class="bi @(user.IsBlocked ? "bi-unlock" : "bi-lock")"></i>
                                    </button>
                                </form>

                                <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Bu istifadəçini silməyə əminsiniz?')">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a asp-action="Rates" class="btn btn-outline-primary">
                <i class="bi bi-currency-exchange"></i> Məzənnələri İdarə Et
            </a>
        </div>
    </div>
</div>