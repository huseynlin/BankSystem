@model BankSystem.Models.User
@{
    ViewData["Title"] = "İstifadəçini Redaktə Et";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h4 class="mb-0">İstifadəçi Məlumatlarını Yenilə</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="UpdateUser" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ad Soyad</label>
                            <input asp-for="FullName" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input asp-for="Email" class="form-control" type="email" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Rol</label>
                            <select asp-for="Role" class="form-select">
                                <option value="Customer">Customer</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Yeni Şifrə (Dəyişmək istəmirsinizsə boş qoyun)</label>
                            <input asp-for="Password" class="form-control" type="password" value="" />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Ləğv Et</a>
                            <button type="submit" class="btn btn-primary">Dəyişiklikləri Saxla</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>