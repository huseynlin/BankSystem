@model BankSystem.Models.User
@{
    ViewData["Title"] = "Yeni İstifadəçi";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Yeni İstifadəçi Yarat</h4>
                </div>
                <div class="card-body p-4">

                    @* --- XƏTA MESAJI BURADA GÖRÜNƏCƏK --- *@
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="CreateUser" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ad Soyad</label>
                            @* asp-for istifadəsi məlumatın itməməsi üçün vacibdir *@
                            <input asp-for="FullName" class="form-control" placeholder="Məs: Elvin Məmmədov" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="elvin@mail.com" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Şifrə</label>
                            <input asp-for="Password" type="password" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Rol</label>
                            <select asp-for="Role" class="form-select">
                                <option value="Customer">Customer (Müştəri)</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Geri Qayıt
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-check-lg"></i> Yarat
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>